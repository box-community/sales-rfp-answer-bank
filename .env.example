# Copy this file to .env and fill in your real values.
# Find credentials in the Box Developer Console:
# https://cloud.app.box.com/developers/console

# CCG app credentials (Configuration tab)
BOX_CLIENT_ID=your_client_id
BOX_CLIENT_SECRET=your_client_secret

# Box user ID the app acts as (Admin Console > Users, or avatar URL).
# Requires "Generate User Access Tokens" on the app.
BOX_USER_ID=your_box_user_id

# Folder ID of your top-level "Sales Content" folder in Box
# (from the URL: https://app.box.com/folder/123456789 → 123456789)
SALES_CONTENT_FOLDER_ID=your_sales_content_folder_id

# Written automatically by create_hub.py; or set manually after hub creation
BOX_HUB_ID=

# Optional: comma-separated emails for manage_access.py
# SALES_REP_EMAILS=rep1@example.com,rep2@example.com
